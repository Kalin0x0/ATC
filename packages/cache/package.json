{
  "name": "@atc/cache",
  "version": "0.1.0",
  "private": true,
  "description": "ATC Redis client and the caches built on it \u2014 sessions, vitals, status effects, rate limiting",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@atc/shared-types": "workspace:*",
    "ioredis": "^5.3.0"
  },
  "devDependencies": {
    "@atc/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
